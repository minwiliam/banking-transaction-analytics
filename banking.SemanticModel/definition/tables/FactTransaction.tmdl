	column CreditScoreGroup = SWITCH(TRUE(), FactTransaction[CustomerScore] < 580, "Poor", FactTransaction[CustomerScore] < 670, "Fair", FactTransaction[CustomerScore] < 740, "Good", FactTransaction[CustomerScore] < 800, "Very Good", "Excellent")
		dataType: string
		lineageTag: e2f5e8b2-d863-4c2e-8956-c32b086457e0

	column OfferExpectedCategory = RELATED(MapOfferCategory[ExpectedCategory])
		dataType: string
		lineageTag: 6bf4aad3-6547-4dee-b0b3-9dbbc1daff0d

	column OfferAligned = IF(FactTransaction[ProductCategory] = FactTransaction[OfferExpectedCategory], 1, 0)
		dataType: int64
		lineageTag: d8dcd5ff-fe58-4d5d-b53c-d8930cf90697

	partition FactTransaction = m
		mode: import
		source =

	column 'Total Fee'
		dataType: double
		lineageTag: 29508ad9-0af2-4cd0-b7e9-6ea6efde5388
		summarizeBy: sum
		sourceColumn: Total Fee

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column CreditScoreGroup = SWITCH(TRUE(), FactTransaction[CustomerScore] < 580, "Poor", FactTransaction[CustomerScore] < 670, "Fair", FactTransaction[CustomerScore] < 740, "Good", FactTransaction[CustomerScore] < 800, "Very Good", "Excellent")
		dataType: string
		lineageTag: e2f5e8b2-d863-4c2e-8956-c32b086457e0

	column IncomeGroup = SWITCH(TRUE(), FactTransaction[MonthlyIncome] < 3500, "Low Income", FactTransaction[MonthlyIncome] < 7000, "Middle Income", "High Income")
		dataType: string
		lineageTag: 43e93a1d-14f1-4fc6-a436-91339fe0323c

	column OfferExpectedCategory = RELATED(MapOfferCategory[ExpectedCategory])
		dataType: string
		lineageTag: 6bf4aad3-6547-4dee-b0b3-9dbbc1daff0d

	column OfferAligned = IF(FactTransaction[ProductCategory] = FactTransaction[OfferExpectedCategory], 1, 0)
		dataType: int64
		lineageTag: d8dcd5ff-fe58-4d5d-b53c-d8930cf90697

	partition FactTransaction = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("C:\Users\Admin\Downloads\Banking_Transactional_Dataset_Cleaned.xlsx"), null, true),
				    Banking_Transactions_Table = Source{[Item="Banking_Transactions",Kind="Table"]}[Data],
				    #"Changed Type" = Table.TransformColumnTypes(Banking_Transactions_Table,{{"TransactionID", Int64.Type}, {"CustomerID", Int64.Type}, {"TransactionDate", type datetime}, {"Year", Int64.Type}, {"Month", Int64.Type}, {"MonthName", type text}, {"Quarter", Int64.Type}, {"YearMonth", type date}, {"TransactionType", type text}, {"Amount", type number}, {"ProductCategory", type text}, {"ProductSubcategory", type text}, {"BranchCity", type text}, {"BranchLat", type number}, {"BranchLong", type number}, {"Channel", type text}, {"Currency", type text}, {"CreditCardFees", type number}, {"InsuranceFees", type number}, {"LatePaymentAmount", type number}, {"CustomerScore", Int64.Type}, {"MonthlyIncome", type number}, {"CustomerSegment", type text}, {"RecommendedOffer", type text}, {"Total Fee", type number}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"TransactionID", "Year", "Month", "MonthName", "Quarter", "YearMonth"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation


table FactTransaction
	lineageTag: 27836ee3-b556-44cf-8c18-efd09f1d9741

	measure 'Total Transactions' = COUNTROWS(FactTransaction)
		formatString: #,##0
		displayFolder: Core KPIs

	measure 'Total Transaction Value' = SUM(FactTransaction[Amount])
		formatString: #,##0
		displayFolder: Core KPIs

	measure 'Total Fees' = SUM(FactTransaction[Total Fee])
		formatString: #,##0
		displayFolder: Core KPIs

	measure 'Average Transaction Value' = DIVIDE([Total Transaction Value], [Total Transactions])
		formatString: #,##0.00
		displayFolder: Core KPIs

	measure 'Average Fee' = DIVIDE([Total Fees], [Total Transactions])
		formatString: #,##0.00
		displayFolder: Core KPIs

	measure 'Active Customers' = DISTINCTCOUNT(FactTransaction[CustomerID])
		formatString: #,##0
		displayFolder: Core KPIs

	measure 'Transactions per Customer' = DIVIDE([Total Transactions], [Active Customers])
		formatString: #,##0.0
		displayFolder: Core KPIs

	measure 'Average Customer Score' = AVERAGE(FactTransaction[CustomerScore])
		formatString: #,##0
		displayFolder: Core KPIs

	measure 'Credit Card Fees' = SUM(FactTransaction[CreditCardFees])
		formatString: #,##0
		displayFolder: Fee Breakdown

	measure 'Insurance Fees' = SUM(FactTransaction[InsuranceFees])
		formatString: #,##0
		displayFolder: Fee Breakdown

	measure 'Late Payment Amount' = SUM(FactTransaction[LatePaymentAmount])
		formatString: #,##0
		displayFolder: Fee Breakdown

	measure 'Total Transaction Value PM' = CALCULATE([Total Transaction Value], DATEADD(DimDate[Date], -1, MONTH))
		formatString: #,##0
		isHidden
		displayFolder: Time Intelligence\Helpers

	measure 'Total Transaction Value PY' = CALCULATE([Total Transaction Value], SAMEPERIODLASTYEAR(DimDate[Date]))
		formatString: #,##0
		isHidden
		displayFolder: Time Intelligence\Helpers

	measure 'Transactions PM' = CALCULATE([Total Transactions], DATEADD(DimDate[Date], -1, MONTH))
		formatString: #,##0
		isHidden
		displayFolder: Time Intelligence\Helpers

	measure 'MoM Growth %' = DIVIDE([Total Transaction Value] - [Total Transaction Value PM], [Total Transaction Value PM])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence

	measure 'YoY Growth %' = DIVIDE([Total Transaction Value] - [Total Transaction Value PY], [Total Transaction Value PY])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence

	measure 'Transaction Growth %' = DIVIDE([Total Transactions] - [Transactions PM], [Transactions PM])
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Time Intelligence

	measure 'Fee Rate %' = DIVIDE([Total Fees], [Total Transaction Value])
		formatString: 0.00%
		displayFolder: Analytical %

	measure 'Fee Contribution %' = DIVIDE([Total Fees], CALCULATE([Total Fees], ALLSELECTED(FactTransaction)))
		formatString: 0.0%
		displayFolder: Analytical %

	measure 'Transaction Share %' = DIVIDE([Total Transactions], CALCULATE([Total Transactions], ALLSELECTED(FactTransaction)))
		formatString: 0.0%
		displayFolder: Analytical %

	measure 'Offer Alignment Rate %' = AVERAGE(FactTransaction[OfferAligned])
		formatString: 0.0%
		displayFolder: Analytical %

	measure 'Most Used Channel' = VAR t = TOPN(1, VALUES(FactTransaction[Channel]), CALCULATE([Total Transactions]), DESC) RETURN CONCATENATEX(t, FactTransaction[Channel])
		formatString: General
		displayFolder: Convenience

	measure 'Most Valuable Transaction Type' = VAR t = TOPN(1, VALUES(FactTransaction[TransactionType]), CALCULATE([Total Transaction Value]), DESC) RETURN CONCATENATEX(t, FactTransaction[TransactionType])
		formatString: General
		displayFolder: Convenience


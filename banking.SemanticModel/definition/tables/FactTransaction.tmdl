				    Source = Excel.Workbook(File.Contents("C:\Users\Admin\Downloads\Banking_Transactional_Dataset_Cleaned.xlsx"), null, true),
				    Banking_Transactions_Table = Source{[Item="Banking_Transactions",Kind="Table"]}[Data],
				    #"Changed Type" = Table.TransformColumnTypes(Banking_Transactions_Table,{{"TransactionID", Int64.Type}, {"CustomerID", Int64.Type}, {"TransactionDate", type datetime}, {"Year", Int64.Type}, {"Month", Int64.Type}, {"MonthName", type text}, {"Quarter", Int64.Type}, {"YearMonth", type date}, {"TransactionType", type text}, {"Amount", type number}, {"ProductCategory", type text}, {"ProductSubcategory", type text}, {"BranchCity", type text}, {"BranchLat", type number}, {"BranchLong", type number}, {"Channel", type text}, {"Currency", type text}, {"CreditCardFees", type number}, {"InsuranceFees", type number}, {"LatePaymentAmount", type number}, {"CustomerScore", Int64.Type}, {"MonthlyIncome", type number}, {"CustomerSegment", type text}, {"RecommendedOffer", type text}, {"Total Fee", type number}}),
